[Unit]
Description=Pi-hole Speedtest v6 companion dashboard
Documentation=https://github.com/RamrattanN/PiHoleSpeedtestV6
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pihole-speedtest
Group=pihole-speedtest
WorkingDirectory=/var/lib/pihole-speedtest
Environment=HOME=/var/lib/pihole-speedtest
ExecStart=/opt/pihole-speedtest/venv/bin/pihole-speedtest serve --database /var/lib/pihole-speedtest/speedtest.db --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pihole-speedtest
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
